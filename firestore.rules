rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────────────
    // These rules are the ONLY real access boundary in this system.
    //
    // Both apps check roles client-side after login (see AuthContext/AuthGate
    // in the console, AuthRepository on the phone), but neither check stops
    // anyone who talks to Firestore directly with a valid session — which is
    // every field reader, since they hold real credentials on a device that
    // leaves the office. Everything below is written on the assumption that
    // an authenticated caller is hostile.
    //
    // Note on sign-up: while account creation runs in the browser (the default
    // — see lib/firebase/accountBackend.ts), Identity Platform must accept
    // self-service sign-up, so anyone holding the public web API key can mint a
    // session. That is exactly why nothing below trusts `request.auth != null`
    // on its own: every rule requires a `users/{uid}` role document, which only
    // an admin can create. A self-registered account can authenticate and then
    // reach precisely nothing.
    //
    // Deploying the Cloud Functions in functions/index.js and setting
    // NEXT_PUBLIC_ACCOUNT_ADMIN_BACKEND=functions lets sign-up be switched off
    // altogether, which closes that gap properly.
    // ─────────────────────────────────────────────────────────────────────────

    // ── Helpers ──────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // A caller counts as a real user of this system only if an admin has given
    // them a role document AND that document isn't disabled.
    //
    // The `disabled` check is what makes revocation work without the Admin SDK.
    // The client SDK cannot disable another Auth account, so an admin pressing
    // "Disable" writes this flag instead; enforcing it here means a disabled
    // account — a lost field phone, say — can no longer read or write anything,
    // even though its Firebase Auth session technically survives.
    function roleExists() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().get('disabled', false) == false;
    }

    function callerRole() {
      return userDoc().role;
    }

    function isAdmin() {
      return roleExists() && callerRole() == "admin";
    }

    /** Console users: full admin, or counter staff. */
    function isConsoleUser() {
      return roleExists() && callerRole() in ["admin", "staff"];
    }

    function isFieldReader() {
      return roleExists() && callerRole() == "field_reader";
    }

    function isStaff() {
      return roleExists() && callerRole() == "staff";
    }

    /** Fields a caller is attempting to add or change on an existing document. */
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ── concessionaires ──────────────────────────────────────────────────────
    //
    // Read: any account with a role document. Field readers need the accounts
    // on their route, and scoping reads per-barangay in rules would require
    // the query itself to carry the constraint — enforced instead by only
    // handing readers a route via users/{uid}.assignedBarangays.
    //
    // Write: console users have full control. Field readers may ONLY touch the
    // billing fields uploadReading() actually writes, and may never create or
    // delete a concessionaire. Without this a reader could zero any balance,
    // rewrite billing history, or flip a status straight from the SDK, with
    // nothing in auditLogs to show for it.

    match /concessionaires/{concessionaireId} {
      allow read: if roleExists();

      // New accounts. An admin's are live immediately. A staff member may
      // create one only as a PENDING request, stamped with their own identity
      // and not yet on anyone's reading route — it stays out of reading,
      // billing and payments until an admin approves it. Enforced here rather
      // than only in the console, which a staff account could otherwise bypass
      // by writing `approvalStatus: "APPROVED"` straight from the SDK.
      allow create: if isAdmin()
        || (isStaff()
            && request.resource.data.get('approvalStatus', '') == 'PENDING'
            && request.resource.data.get('approvalRequestedBy', '') == request.auth.token.email
            && !request.resource.data.keys().hasAny([
                 'approvalReviewedBy',
                 'approvalReviewedAt',
                 'approvalRejectionReason',
                 'assignedForReading'
               ]));

      // Deleting an account takes its billing history with it, so it sits with
      // the same person who approves money — not with the counter.
      allow delete: if isAdmin();

      // Only an admin decides an approval, puts an account on a reading route,
      // or moves money. Staff keep editing the details — names, purok,
      // classification, requirements, remarks — but a payment, a connection
      // fee, a balance or a service status changes only when an admin applies
      // the matching request in /serviceRequests. Enforced here and not just
      // in the console, which a staff account could otherwise bypass by
      // writing the balance straight from the SDK.
      //
      // `billingHistory` is still listed for readers because accounts the
      // storage migration hasn't reached yet keep theirs; nothing writes it.
      allow update: if isAdmin()
        || (isStaff() && !changed().hasAny([
              'approvalStatus',
              'approvalReviewedBy',
              'approvalReviewedAt',
              'approvalRejectionReason',
              'assignedForReading',
              'status',
              'disconnectedReason',
              'billingBalance',
              'creditBalance',
              'totalBalance',
              'waterMeterBalance',
              'billingSummary',
              'billingHistory',
              'payments',
              'meterPayments',
              'connectionFeeDetails',
              'delinquentSince'
            ]))
        || (isFieldReader() && changed().hasOnly([
              'billingHistory',
              'billingSummary',
              'billingBalance',
              'creditBalance',
              'totalBalance',
              'delinquentSince',
              'updatedAt'
            ]));

      // ── bills ──────────────────────────────────────────────────────────
      // One document per billing cycle, keyed by month ("2026-08"), holding
      // the itemised bill. Field readers create and correct the bill for the
      // cycle they're reading; only console users may remove one, and even
      // then a bill is normally voided in place rather than deleted so its OR
      // number stays accounted for.
      match /bills/{monthKey} {
        allow read: if roleExists();
        allow create, update: if isAdmin() || isFieldReader();
        allow delete: if isAdmin();
      }

      // ── payments ───────────────────────────────────────────────────────
      // Receipts against the water bill, keyed by the OR number written on the
      // paper receipt. A receipt appears here only when an admin posts the
      // payment — a staff member at the counter submits a request instead, so
      // the money on the account and the money in the drawer are reconciled by
      // someone other than whoever took it. Readers may see them but never
      // write one, and nothing may delete a receipt that was issued: voiding
      // marks it in place.
      match /payments/{orNumber} {
        allow read: if roleExists();
        allow create, update: if isAdmin();
        allow delete: if false;
      }
    }

    // Collection-group reads: the Billing list, Reports and the recent
    // payments feed query across every account's sub-collections at once.
    // Firestore evaluates these against a separate match path, so the rules
    // above are not enough on their own.
    match /{path=**}/bills/{monthKey} {
      allow read: if roleExists();
    }
    match /{path=**}/payments/{orNumber} {
      allow read: if isConsoleUser();
    }

    // ── serviceRequests ──────────────────────────────────────────────────────
    // What staff have asked an admin to apply: a payment taken at the counter,
    // a connection being set up, or a line to be reconnected. Nothing in here
    // has touched an account — it is the admin approving it that does.
    //
    // Staff may only file one, under their own name and PENDING. Every
    // decision field is an admin's, so a staff account cannot approve its own
    // request, backdate a review, or reopen one that was rejected.

    match /serviceRequests/{requestId} {
      // An admin works the whole queue; a staff member sees only what they
      // sent. Their own subscription filters by requestedBy, which is what
      // lets a list query satisfy this per-document rule.
      allow read: if isAdmin() || resource.data.requestedBy == request.auth.token.email;

      allow create: if isConsoleUser()
        && request.resource.data.status == 'PENDING'
        && request.resource.data.requestedBy == request.auth.token.email
        && !request.resource.data.keys().hasAny([
             'reviewedBy',
             'reviewedAt',
             'rejectionReason',
             'completedBy',
             'completedAt',
             'outcome'
           ]);

      allow update: if isAdmin();
      allow delete: if false;
    }

    // ── settings ─────────────────────────────────────────────────────────────
    // The shared atomic counters. `orCounter` numbers bills; `accountNumberCounter`
    // numbers accounts as they are opened. (`paymentOrCounter` is left here for
    // older clients — receipts now carry the OR typed off the paper receipt, so
    // nothing mints payment numbers any more.)
    //
    // Numbering continuity is a control in both cases, so a counter may only
    // ever move forward, and only these documents exist. `year` rolling forward
    // restarts the sequence, which is the intended per-year numbering.
    //
    // An account import reserves a block at once, so that counter may jump by
    // more than one; a bill mints a single number at a time.

    function isCounter(settingId) {
      return settingId in ["orCounter", "paymentOrCounter", "accountNumberCounter"];
    }

    /**
     * Who may move which counter. A field reader bills from the phone, so it
     * has to be able to mint a bill number; nothing in the field opens an
     * account, so the account counter stays with the office.
     */
    function mayMoveCounter(settingId) {
      return settingId == "accountNumberCounter" ? isConsoleUser() : roleExists();
    }

    match /settings/{settingId} {
      allow read: if roleExists();

      allow create: if isCounter(settingId)
        && mayMoveCounter(settingId)
        && request.resource.data.lastNumber >= 1;

      allow update: if isCounter(settingId)
        && mayMoveCounter(settingId)
        && (
             // same year: moves forward, never back
             (request.resource.data.year == resource.data.year
               && request.resource.data.lastNumber > resource.data.lastNumber)
             // new year: sequence restarts
             || (request.resource.data.year > resource.data.year
               && request.resource.data.lastNumber >= 1)
           );

      allow delete: if false;
    }

    // ── users ────────────────────────────────────────────────────────────────
    // Role and profile documents. A caller may read their OWN document (both
    // apps do this immediately after login to resolve their role, and the
    // phone listens to it for barangay assignments); only admins may read the
    // rest. Previously any signed-in account could enumerate every admin and
    // staff email, real name, phone number and role — a ready-made target list
    // for phishing exactly the accounts that hold privileges.
    //
    // Writes stay admin-only, which is what prevents an account from granting
    // itself `role: "admin"`. Admins additionally may not demote or delete
    // themselves, so the last admin can't lock everyone out by accident.

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      allow create: if isAdmin();
      // An admin may not change their own role or disable themselves — locking
      // the last admin out of their own console helps nobody.
      //
      // Anyone may edit their own name and phone number on the Profile page,
      // and nothing else: a role, an email or a disabled flag stays the
      // admin's to set, so an account cannot promote itself by editing its own
      // profile.
      allow update: if (isAdmin()
        && (request.auth.uid != userId
            || (request.resource.data.role == resource.data.role
                && request.resource.data.get('disabled', false) == false)))
        || (roleExists()
            && request.auth.uid == userId
            && changed().hasOnly(['firstName', 'lastName', 'phoneNumber']));
      allow delete: if isAdmin() && request.auth.uid != userId;
    }

    // ── auditLogs ────────────────────────────────────────────────────────────
    // Append-only event log. Any account with a role may append — staff take
    // payments and issue receipts, and those are precisely the events the log
    // exists for; when writes were admin-only they were silently rejected
    // (logAuditEvent is fire-and-forget) and cash movements went unrecorded.
    //
    // `user` is pinned to the caller's own identity so an entry can't be
    // written under someone else's name, and entries can never be edited or
    // removed once written.

    match /auditLogs/{logId} {
      allow read: if isAdmin();

      allow create: if roleExists()
        && request.resource.data.user == request.auth.token.email
        && request.resource.data.timestamp == request.time
        && request.resource.data.keys().hasOnly(['actionType', 'description', 'user', 'timestamp']);

      allow update, delete: if false;
    }

    // Catch-all for any other collections (locked down by default)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
